model DirectorCommitment {
  id              String    @id @default(cuid())
  careerId        String
  sourceEventId   String?
  stakeholderType String
  stakeholderId   String?
  title           String
  metric          String
  target          Float
  tolerance       Float     @default(0)
  baseline        Float?
  dueDay          Int
  severity        String    @default("MEDIUM")
  status          String    @default("TRACKING")
  progress        Float?
  explanation     String
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  career DirectorCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@index([careerId, status, dueDay])
}

model DirectorRelationship {
  id          String   @id @default(cuid())
  careerId    String
  actorType   String
  actorId     String?
  actorName   String
  trust       Float    @default(60)
  respect     Float    @default(60)
  alignment   Float    @default(50)
  conflicts   Float    @default(0)
  credibility Float    @default(60)
  priorities  Json     @default("{}")
  memory      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  career DirectorCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([careerId, actorType, actorName])
  @@index([careerId, actorType])
}

model DirectorLedgerEntry {
  id          String   @id @default(cuid())
  careerId    String
  clubId      String
  dayIndex    Int
  category    String
  direction   String
  amount      Int
  status      String   @default("POSTED")
  dueDay      Int?
  sourceType  String
  sourceId    String?
  description String
  createdAt   DateTime @default(now())

  career DirectorCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@index([careerId, clubId, dayIndex])
  @@index([careerId, status, dueDay])
}

model DirectorSeason {
  id           String    @id @default(cuid())
  careerId     String
  number       Int       @default(1)
  startDay     Int       @default(0)
  endDay       Int
  status       String    @default("ACTIVE")
  currentRound Int       @default(0)
  rules        Json      @default("{}")
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  career     DirectorCareer            @relation(fields: [careerId], references: [id], onDelete: Cascade)
  standings  DirectorStanding[]
  objectives DirectorSeasonObjective[]
  reviews    DirectorBoardReview[]
  matches    DirectorMatch[]

  @@unique([careerId, number])
}

model DirectorSeasonObjective {
  id          String   @id @default(cuid())
  careerId    String
  seasonId    String
  clubId      String
  kind        String
  target      Float
  weight      Float
  progress    Float?
  status      String   @default("TRACKING")
  explanation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  career DirectorCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)
  season DirectorSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, clubId, kind])
  @@index([careerId, status])
}

model DirectorBoardReview {
  id             String   @id @default(cuid())
  careerId       String
  seasonId       String
  clubId         String
  kind           String
  dayIndex       Int
  sporting       Float
  finance        Float
  academy        Float
  infrastructure Float
  overall        Float
  outcome        String
  explanation    Json     @default("[]")
  createdAt      DateTime @default(now())

  career DirectorCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)
  season DirectorSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, clubId, kind])
  @@index([careerId, dayIndex])
}

model DirectorJobOffer {
  id         String   @id @default(cuid())
  careerId   String
  clubId     String
  role       String   @default("DIRECTOR")
  status     String   @default("OPEN")
  expiresDay Int
  terms      Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  career DirectorCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@index([careerId, status, expiresDay])
}

model DirectorStanding {
  id             String   @id @default(cuid())
  seasonId       String
  clubId         String
  played         Int      @default(0)
  wins           Int      @default(0)
  draws          Int      @default(0)
  losses         Int      @default(0)
  goalsFor       Int      @default(0)
  goalsAgainst   Int      @default(0)
  points         Int      @default(0)
  expectedPoints Float    @default(0)
  performance    Float    @default(0)
  updatedAt      DateTime @updatedAt

  season DirectorSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  club   DirectorClub   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([seasonId, clubId])
  @@index([seasonId, points])
}

model DirectorClubNeed {
  id               String   @id @default(cuid())
  careerId         String
  clubId           String
  kind             String
  target           String
  urgency          Float
  reason           String
  status           String   @default("OPEN")
  lastEvaluatedDay Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  career DirectorCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([careerId, clubId, kind, target])
  @@index([careerId, status, urgency])
}

model DirectorCausalLog {
  id          String   @id @default(cuid())
  careerId    String
  dayIndex    Int
  sourceType  String
  sourceId    String?
  effectId    String?
  category    String
  headline    String
  explanation String
  targetType  String?
  targetId    String?
  importance  Int      @default(1)
  createdAt   DateTime @default(now())

  career DirectorCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@index([careerId, dayIndex, importance])
  @@index([careerId, sourceType, sourceId])
}

/// Oblíbená liga uživatele (PRO) – v Programu Zápasů se všechny její zápasy počítají jako
/// oblíbené (primární sekce + filtr „Jen oblíbené"). Bez snapshot meta – filtr pracuje jen
/// nad už načteným 7denním Programem, stačí id.
model FavoriteLeague {
  // Stabilní vlastnický klíč = e-mail (přežije re-login/reset User řádku). Viz UserTip.
  email     String
  userId    String?
  leagueId  Int
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([email, leagueId])
}

/// Oblíbený konkrétní zápas uživatele (PRO). Sjednocení s FavoriteLeague řídí „oblíbenost".
model FavoriteFixture {
  // Stabilní vlastnický klíč = e-mail (přežije re-login/reset User řádku). Viz UserTip.
  email     String
  userId    String?
  fixtureId Int
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([email, fixtureId])
}

/// Web Push zařízení přihlášeného uživatele. Endpoint i klíče jsou tajné doručovací údaje
/// a nikdy se neposílají jinému uživateli ani do veřejného payloadu.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// První verze notifikací je záměrně malá: připomínka oblíbeného zápasu. Další typy
/// lze přidat bez změny PushSubscription a bez opětovného povolování zařízení.
model NotificationPreference {
  userId               String   @id
  enabled              Boolean  @default(true)
  favoriteKickoff      Boolean  @default(true)
  kickoffMinutes       Int      @default(60)
  publishedPrediction  Boolean  @default(false)
  marketMovement       Boolean  @default(false)
  movementThreshold    Int      @default(3)
  smartFavoriteLeagues Boolean  @default(false)
  halftimeAndFinal     Boolean  @default(false)
  checklistCandidate   Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Idempotence push cronu: stejný uživatel nedostane tutéž událost dvakrát ani při
/// opakovaném nebo zpožděném běhu GitHub Actions.
model NotificationDelivery {
  id        String   @id @default(cuid())
  userId    String
  fixtureId Int
  type      String
  sentAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fixtureId, type])
  @@index([sentAt])
}
