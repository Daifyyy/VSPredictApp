  identityTags     Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubs             DirectorClub[]
  events            DirectorEvent[]
  pulsePosts        DirectorPulsePost[]
  achievements      DirectorAchievement[]
  matches           DirectorMatch[]
  negotiations      DirectorNegotiation[]
  projects          DirectorProject[]
  effects           DirectorCausalEffect[]
  commitments       DirectorCommitment[]
  relationships     DirectorRelationship[]
  ledger            DirectorLedgerEntry[]
  seasons           DirectorSeason[]
  needs             DirectorClubNeed[]
  causalLogs        DirectorCausalLog[]
  agents            DirectorAgent[]
  expectations      DirectorPlayerExpectation[]
  squadGroups       DirectorSquadGroup[]
  staff             DirectorStaff[]
  transferCases     DirectorTransferCase[]
  registrations     DirectorRegistration[]
  coachCandidates   DirectorCoachCandidate[]
  coachNegotiations DirectorCoachNegotiation[]
  objectives        DirectorSeasonObjective[]
  boardReviews      DirectorBoardReview[]
  jobOffers         DirectorJobOffer[]
  sportPolicies     DirectorSportPolicy[]
  sportMeetings     DirectorSportMeeting[]
  matchPlans        DirectorMatchPlan[]
  playerAppearances DirectorPlayerAppearance[]
  coachMemories     DirectorCoachMemory[]
  trainingCycles    DirectorTrainingCycle[]
  opponentAnalyses  DirectorOpponentAnalysis[]
  medicalReports    DirectorMedicalReport[]
  planReviews       DirectorPlanReview[]

  @@index([userId, status])
  @@index([ownerEmail, createdAt])
}

